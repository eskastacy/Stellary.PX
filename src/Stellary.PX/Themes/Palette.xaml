<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Stellary.PX — Black Chrome palette. Monochrome only; semantic hues are desaturated. -->
    <Color x:Key="C.Ink">#08080A</Color>
    <Color x:Key="C.Ink2">#0C0C0F</Color>
    <Color x:Key="C.Surface">#111114</Color>
    <Color x:Key="C.Surface2">#15151A</Color>
    <Color x:Key="C.Surface3">#1A1A20</Color>
    <Color x:Key="C.Hairline">#26262E</Color>
    <Color x:Key="C.HairlineSoft">#1C1C23</Color>
    <Color x:Key="C.Text">#ECECF0</Color>
    <Color x:Key="C.Muted">#95959E</Color>
    <Color x:Key="C.Dim">#5F5F69</Color>
    <Color x:Key="C.ChromeHi">#F6F6F8</Color>
    <Color x:Key="C.ChromeMid">#C3C3CB</Color>
    <Color x:Key="C.ChromeLo">#6C6C77</Color>
    <Color x:Key="C.Ok">#98A9A0</Color>
    <Color x:Key="C.Warn">#B39183</Color>
    <Color x:Key="C.Info">#8A95A3</Color>

    <SolidColorBrush x:Key="B.Ink" Color="{StaticResource C.Ink}" />
    <SolidColorBrush x:Key="B.Ink2" Color="{StaticResource C.Ink2}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.Surface2" Color="{StaticResource C.Surface2}" />
    <SolidColorBrush x:Key="B.Surface3" Color="{StaticResource C.Surface3}" />
    <SolidColorBrush x:Key="B.Hairline" Color="{StaticResource C.Hairline}" />
    <SolidColorBrush x:Key="B.HairlineSoft" Color="{StaticResource C.HairlineSoft}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.Muted" Color="{StaticResource C.Muted}" />
    <SolidColorBrush x:Key="B.Dim" Color="{StaticResource C.Dim}" />
    <SolidColorBrush x:Key="B.Ok" Color="{StaticResource C.Ok}" />
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="B.Info" Color="{StaticResource C.Info}" />

    <LinearGradientBrush x:Key="B.Chrome" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBFBFC" Offset="0" />
        <GradientStop Color="#D6D6DC" Offset="0.34" />
        <GradientStop Color="#9A9AA4" Offset="0.62" />
        <GradientStop Color="#E9E9EE" Offset="0.84" />
        <GradientStop Color="#8B8B95" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.ChromeLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3C3C45" Offset="0" />
        <GradientStop Color="#6A6A74" Offset="0.18" />
        <GradientStop Color="#242429" Offset="0.55" />
        <GradientStop Color="#3A3A42" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.Card" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141419" Offset="0" />
        <GradientStop Color="#101014" Offset="0.55" />
        <GradientStop Color="#0D0D11" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.CardRaised" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#191920" Offset="0" />
        <GradientStop Color="#121217" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.Sidebar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0B0B0E" Offset="0" />
        <GradientStop Color="#0A0A0C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.FadeLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#3A3A44" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="B.Vignette" Center="0.5,0.35" GradientOrigin="0.5,0.35" RadiusX="0.85" RadiusY="0.85">
        <GradientStop Color="#1A1A22" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
