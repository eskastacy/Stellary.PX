<UserControl x:Class="Stellary.PX.Views.EmulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">

            <TextBlock Text="Target acquisition, process privilege, cache hygiene, and driver repair for the Android emulator."
                       Style="{StaticResource T.Body}" Margin="2,0,0,14" />

            <!-- Target -->
            <Border Style="{StaticResource CardRaised}" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="TARGET PROCESS" Style="{StaticResource T.Eyebrow}" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{Binding Running, Converter={StaticResource StatusBrush}}" />
                                <TextBlock Text="{Binding TargetName}" FontFamily="{StaticResource F.Light}"
                                           FontSize="26" Foreground="{StaticResource B.Text}" Margin="10,0,0,0" />
                                <TextBlock Text="{Binding TargetState}" FontFamily="{StaticResource F.Body}"
                                           FontSize="11" Foreground="{StaticResource B.Muted}"
                                           VerticalAlignment="Bottom" Margin="12,0,0,5" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
                            <Button Content="Open install" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenInstallCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="EXECUTABLE" Style="{StaticResource T.Eyebrow}" />
                            <TextBlock Text="{Binding TargetPath}" Style="{StaticResource T.Mono}" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="INSTALL ROOT" Style="{StaticResource T.Eyebrow}" />
                            <TextBlock Text="{Binding InstallDir}" Style="{StaticResource T.Mono}" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Border Style="{StaticResource Hairline}" Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Boost priority" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BoostCommand}" />
                            <Button Content="Restore normal" Style="{StaticResource GhostButton}"
                                    Command="{Binding RestorePriorityCommand}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource T.Small}"
                                       VerticalAlignment="Center" Margin="16,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Priority -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="PROCESS PRIVILEGE" Style="{StaticResource T.Eyebrow}" />
                        <TextBlock Text="{Binding Priority}" FontFamily="{StaticResource F.Light}" FontSize="22"
                                   Foreground="{StaticResource B.Text}" Margin="0,7,0,4" />
                        <TextBlock Style="{StaticResource T.Small}"
                                   Text="Above-normal scheduling gives the emulator more CPU time while the desktop stays responsive. BlueStacks 5.22 can deny priority changes; the app reports the block instead of bypassing it." />
                        <Border Style="{StaticResource Hairline}" Margin="0,12" />
                        <TextBlock Text="Applies to HD-Player.exe automatically on pipeline start." Style="{StaticResource T.Small}" />
                    </StackPanel>
                </Border>

                <!-- Cache -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="QML CACHE" Style="{StaticResource T.Eyebrow}" />
                            <TextBlock Text="{Binding CacheText}" FontFamily="{StaticResource F.Light}" FontSize="22"
                                       Foreground="{StaticResource B.Text}" Margin="0,7,0,4" />
                            <TextBlock Style="{StaticResource T.Small}"
                                       Text="Clears compiled QML caches for the detected install. Application data, installed apps, and games are preserved." />
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Border Style="{StaticResource Hairline}" Margin="0,12" />
                            <TextBlock Style="{StaticResource T.Small}"
                                       Text="Measured before deletion · no registry changes · safe to repeat." />
                        </StackPanel>

                        <Button Grid.Row="3" Content="Clean cache" Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding CleanCacheCommand}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Drivers -->
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="DRIVER INTEGRITY" Style="{StaticResource T.Eyebrow}" />
                            <TextBlock Text="BlueStacks 5.22 driver repair" FontFamily="{StaticResource F.Medium}"
                                       FontSize="15" Foreground="{StaticResource B.Text}" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Content="Replace from file…" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding ReplaceDriverCommand}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DRIVER" Style="{StaticResource T.Eyebrow}" FontSize="8" />
                        <TextBlock Grid.Column="1" Text="VERSION" Style="{StaticResource T.Eyebrow}" FontSize="8" />
                        <TextBlock Grid.Column="2" Text="SHA-256" Style="{StaticResource T.Eyebrow}" FontSize="8" />
                        <TextBlock Grid.Column="3" Text="SIGNATURE" Style="{StaticResource T.Eyebrow}" FontSize="8"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Drivers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource B.HairlineSoft}" BorderThickness="0,1,0,0"
                                        Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="128" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Family}" FontFamily="{StaticResource F.Medium}"
                                                       FontSize="12" Foreground="{StaticResource B.Text}" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource T.Mono}"
                                                       FontSize="9.5" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource T.Mono}"
                                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Hash}" Style="{StaticResource T.Mono}"
                                                   FontSize="8.5" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Hash}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#4E4E58" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Signed}" Value="True">
                                                                <Setter Property="Fill" Value="#98A9A0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding SignedText}" Style="{StaticResource T.Small}"
                                                       FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="3" Style="{StaticResource T.Small}" Margin="0,12,0,0"
                               Text="Only Authenticode-trusted .sys files are accepted. The current driver is backed up to ProgramData\Stellary.PX\backup before replacement. Close the emulator first." />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
