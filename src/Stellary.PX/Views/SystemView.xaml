<UserControl x:Class="Stellary.PX.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="2,0,0,14"
                       Text="Power, timing, and registry behavior. Every change here is reversible from the same card."
                       Style="{StaticResource T.Body}" />

            <!-- ============ POWER + TIMER ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardRaised}" Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="POWER SCHEME" Style="{StaticResource T.Eyebrow}" />
                        <TextBlock Grid.Row="1" Text="{Binding PowerName}" FontFamily="{StaticResource F.Light}" FontSize="23"
                                   Foreground="{StaticResource B.Text}" Margin="0,8,0,4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Style="{StaticResource T.Small}"
                                   Text="Ultimate Performance removes core parking and latency hints. If the scheme is hidden, it is duplicated once via powercfg." />

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Activate ultimate" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ActivateCommand}" />
                            <Button Content="Restore" Style="{StaticResource GhostButton}"
                                    Command="{Binding RestorePowerCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardRaised}" Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="FRAME TIMER" Style="{StaticResource T.Eyebrow}" />
                            <TextBlock Text="{Binding TimerMs, StringFormat=request {0:0.0} ms}" Style="{StaticResource T.Small}"
                                       FontSize="9.5" HorizontalAlignment="Right" />
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding TimerText}" FontFamily="{StaticResource F.Light}" FontSize="23"
                                       Foreground="{StaticResource B.Text}" />
                            <TextBlock Text="system resolution" Style="{StaticResource T.Small}" FontSize="9.5"
                                       VerticalAlignment="Bottom" Margin="9,0,0,4" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Slider Style="{StaticResource Slider}" Minimum="0.5" Maximum="2.0"
                                    Value="{Binding TimerMs, Mode=TwoWay}" />
                            <Grid Margin="1,4,1,0">
                                <TextBlock Text="0.5 ms" Style="{StaticResource T.Small}" FontSize="9"
                                           HorizontalAlignment="Left" />
                                <TextBlock Text="2.0 ms" Style="{StaticResource T.Small}" FontSize="9"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Style="{StaticResource T.Small}" FontSize="9.5" Margin="0,9,0,0"
                                   Text="Process-scoped: the request is dropped when Stellary.PX exits." />

                        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Lock timer" Style="{StaticResource GhostButton}"
                                    Command="{Binding LockTimerCommand}" />
                            <Button Content="Release" Style="{StaticResource GhostButton}"
                                    Command="{Binding ReleaseTimerCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ REGISTRY + BEHAVIOR ============ -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="GAMING REGISTRY" Style="{StaticResource T.Eyebrow}" />
                            <TextBlock Text="GameDVR + FSE behavior" FontFamily="{StaticResource F.Medium}" FontSize="15"
                                       Foreground="{StaticResource B.Text}" Margin="0,6,0,3" />
                            <TextBlock Text="{Binding RegistryText}" Style="{StaticResource T.Small}" />
                            <Border Style="{StaticResource Hairline}" Margin="0,12" />
                            <TextBlock Style="{StaticResource T.Small}" Margin="0,0,0,3"
                                       Text="Target values: background capture off · Game DVR off · FSE compatibility on · Game Mode on · Game Bar overlay off" />
                            <TextBlock Style="{StaticResource T.Small}"
                                       Text="Written under HKCU. Original values are recorded and restored on request." />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Apply now" Style="{StaticResource GhostButton}"
                                    Command="{Binding ApplyRegistryCommand}" />
                            <Button Content="Restore values" Style="{StaticResource GhostButton}"
                                    Command="{Binding RestoreRegistryCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="PIPELINE BEHAVIOR" Style="{StaticResource T.Eyebrow}" />

                            <Grid Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Lock timer" FontFamily="{StaticResource F.Body}" FontSize="12"
                                               Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="Request the selected resolution on start." Style="{StaticResource T.Small}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding LockTimerOnStart, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,13,0,0">
                                <StackPanel>
                                    <TextBlock Text="Power plan" FontFamily="{StaticResource F.Body}" FontSize="12"
                                               Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="Switch to Ultimate Performance." Style="{StaticResource T.Small}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding ApplyPowerPlan, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,13,0,0">
                                <StackPanel>
                                    <TextBlock Text="Gaming registry" FontFamily="{StaticResource F.Body}" FontSize="12"
                                               Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="Apply GameDVR/FSE values." Style="{StaticResource T.Small}" />
                                </StackPanel>
                                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding ApplyRegistryTweaks, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource Hairline}" Margin="0,14,0,10" />
                        <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource T.Small}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ REVERSIBILITY ============ -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="22,18" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="REVERSIBILITY" Style="{StaticResource T.Eyebrow}" />
                        <TextBlock Text="Scoped by design." FontFamily="{StaticResource F.Medium}" FontSize="15"
                                   Foreground="{StaticResource B.Text}" Margin="0,6,0,3" />
                        <TextBlock Style="{StaticResource T.Small}"
                                   Text="Nothing is written without a way back. Timer requests die with the process; power and registry writes are captured first." />

                        <Border Style="{StaticResource Hairline}" Margin="0,12,0,2" />

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="4" Height="4" Fill="{StaticResource B.Chrome}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Process timer" Style="{StaticResource T.Small}" FontSize="10" />
                            <TextBlock Grid.Column="2" Text="{Binding TimerState}" Style="{StaticResource T.Mono}"
                                       FontSize="9.5" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="4" Height="4" Fill="{StaticResource B.Chrome}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Power scheme" Style="{StaticResource T.Small}" FontSize="10" />
                            <TextBlock Grid.Column="2" Text="{Binding PowerState}" Style="{StaticResource T.Mono}"
                                       FontSize="9.5" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="4" Height="4" Fill="{StaticResource B.Chrome}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Gaming registry" Style="{StaticResource T.Small}" FontSize="10" />
                            <TextBlock Grid.Column="2" Text="{Binding RegistryText}" Style="{StaticResource T.Mono}"
                                       FontSize="9.5" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
                            Background="{StaticResource B.HairlineSoft}" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BACKUP STORE" Style="{StaticResource T.Eyebrow}" />
                        <TextBlock Text="{Binding BackupPath}" Style="{StaticResource T.Mono}" FontSize="9.5"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding BackupPath}" />
                        <TextBlock Style="{StaticResource T.Small}" Margin="0,8,0,0"
                                   Text="Written before any value changes. Kept locally; never uploaded." />
                        <Button Content="Open backup folder" Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding OpenBackupsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
