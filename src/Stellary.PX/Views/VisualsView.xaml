<UserControl x:Class="Stellary.PX.Views.VisualsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="2,0,0,14"
                       Text="Preset compiler for the renderer pipeline. Values are written to a portable JSON file; the emulator renderer consumes them when attached."
                       Style="{StaticResource T.Body}" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <!-- ============ PARAMETERS ============ -->
                <Border Grid.Column="0" Style="{StaticResource CardRaised}" Padding="24,20,20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,4,0">
                            <TextBlock Text="LIVE PARAMETERS" Style="{StaticResource T.Eyebrow}" />
                            <TextBlock Text="{Binding ActivePresetText}" Style="{StaticResource T.Eyebrow}"
                                       HorizontalAlignment="Right" Foreground="{StaticResource B.Muted}" />
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Sliders}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,26,0" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource F.Body}"
                                                       FontSize="11.5" Foreground="{StaticResource B.Muted}" />
                                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource T.Mono}"
                                                       FontSize="10.5" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource B.Text}" />
                                        </Grid>
                                        <Slider Style="{StaticResource Slider}" Minimum="0" Maximum="100"
                                                Value="{Binding Value, Mode=TwoWay}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Border Style="{StaticResource Hairline}" Margin="0,0,0,11" VerticalAlignment="Top" />
                            <Grid Margin="0,12,4,0">
                                <TextBlock Style="{StaticResource T.Small}" FontSize="9.5"
                                           Text="Range 0–100 · neutral 50 · writes 500 ms after the last move" />
                                <TextBlock Text="preset schema · 1" Style="{StaticResource T.Mono}" FontSize="9"
                                           Foreground="{StaticResource B.Dim}" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ RIGHT COLUMN ============ -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="20,17">
                        <StackPanel>
                            <TextBlock Text="PRESETS" Style="{StaticResource T.Eyebrow}" />

                            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,11,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Name}" HorizontalContentAlignment="Left"
                                                Padding="14,9" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Medium}" FontSize="12"
                                                               Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                                                        <Ellipse Width="4" Height="4" Fill="{StaticResource B.Chrome}"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="ACTIVE" Style="{StaticResource T.Eyebrow}" FontSize="7.5"
                                                                   Foreground="{StaticResource B.Muted}" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource T.Small}"
                                                           FontSize="10" Margin="0,3,0,0" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="RENDERER" Style="{StaticResource T.Eyebrow}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="#B39183" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AttachText}" Style="{StaticResource T.Small}" FontSize="9"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding RendererStatus}" Style="{StaticResource T.Small}" Margin="0,9,0,0" />
                            <Border Style="{StaticResource Hairline}" Margin="0,12" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource T.Small}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="PRESET STORE" Style="{StaticResource T.Eyebrow}" />
                            <TextBlock Text="{Binding PresetPath}" Style="{StaticResource T.Mono}" FontSize="9.5"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PresetPathFull}" />
                            <TextBlock Text="{Binding PresetMeta}" Style="{StaticResource T.Small}" FontSize="9.5"
                                       Margin="0,5,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Export preset" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ExportCommand}" />
                                <Button Content="Reset" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Command="{Binding ResetCommand}" />
                            </StackPanel>
                            <Button Content="Open exports folder" Style="{StaticResource LinkButton}" Margin="0,9,0,0"
                                    Command="{Binding OpenPresetFolderCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
