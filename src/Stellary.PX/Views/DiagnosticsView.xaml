<UserControl x:Class="Stellary.PX.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="0,0,6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,0,14">
            <TextBlock Text="Read-only system audit: runtime, instrumentation scan, binary integrity, and the session log."
                       Style="{StaticResource T.Body}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Rescan" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
                <Button Content="Copy report" Style="{StaticResource GhostButton}" Command="{Binding CopyReportCommand}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardRaised}" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="SYSTEM" Style="{StaticResource T.Eyebrow}" />
                    <TextBlock Text="{Binding SystemText}" Style="{StaticResource T.Mono}" FontSize="10.5"
                               LineHeight="20" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource T.Small}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="BINARY INTEGRITY" Style="{StaticResource T.Eyebrow}" />
                        <TextBlock Text="SHA-256 · self" Style="{StaticResource T.Small}" Margin="0,7,0,4" />
                        <TextBlock Text="{Binding HashText}" Style="{StaticResource T.Mono}" FontSize="9.5"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SumsText}" Style="{StaticResource T.Small}" Margin="0,8,0,0" />
                        <Button Content="Open data folder" Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Command="{Binding OpenDataCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="INSTRUMENTATION" Style="{StaticResource T.Eyebrow}" />
                            <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource T.Small}" FontSize="9.5"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Tools}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Ellipse Width="4" Height="4" Fill="{StaticResource B.Warn}"
                                                 VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" FontSize="10"
                                                   Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="22,18,22,14" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="SESSION LOG" Style="{StaticResource T.Eyebrow}" />
                    <Button Content="Open logs" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                            Command="{Binding OpenLogsCommand}" />
                </Grid>
                <Border Grid.Row="1" Background="#0A0A0D" BorderBrush="{StaticResource B.HairlineSoft}"
                        BorderThickness="1" CornerRadius="2">
                    <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="{StaticResource F.Mono}" FontSize="10.5" Foreground="#A6A6B0"
                             Background="Transparent" BorderThickness="0" Padding="14,12"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="NoWrap" />
                </Border>
                <TextBlock Grid.Row="2" Style="{StaticResource T.Small}" FontSize="9" Margin="2,8,0,0"
                           Text="%APPDATA%\Stellary.PX\logs · one file per day" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
