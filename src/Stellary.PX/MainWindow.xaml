<Window x:Class="Stellary.PX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Stellary.PX"
        Width="1360" Height="840" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource B.Ink}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Geometry x:Key="Ico.TikTok">M14.5 3v9.4a4.1 4.1 0 1 1-3.2-4 M14.5 3c.4 1.9 1.8 3.1 3.7 3.3</Geometry>
        <Geometry x:Key="Ico.Instagram">M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4z M12 8.5a3.5 3.5 0 1 0 .01 0z M17.2 6.8h.01</Geometry>
        <Geometry x:Key="Ico.WhatsApp">M20.5 11.6a8.5 8.5 0 0 1-12.6 7.5L3.5 20.5l1.4-4.3A8.5 8.5 0 1 1 20.5 11.6z M8.9 8c-.2 0-.5.1-.7.3-.3.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.7 2.7 4.2 3.7 1.9.8 2.3.6 2.7.6.4 0 1.3-.5 1.5-1.1.2-.5.2-1 .1-1.1l-.6-.3-1.6-.8c-.2-.1-.4-.1-.6.1l-.7.9c-.1.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.3.1-.4l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4z</Geometry>
        <Geometry x:Key="Ico.Discord">M8.5 6.5c2.3-.7 4.7-.7 7 0 M7 18c-1.5-1.2-2.6-3-3-5.5.5-2.7 1.8-5 3.6-6.6l1.6-.6 1 1.7c1.2-.2 2.4-.2 3.6 0l1-1.7 1.6.6c1.8 1.6 3.1 3.9 3.6 6.6-.4 2.5-1.5 4.3-3 5.5l-1.6-2.2 M7 18l-1.5 2.5 M17 18l1.5 2.5 M9.5 12.5h.01 M14.5 12.5h.01</Geometry>
        <Geometry x:Key="Ico.Linktree">M12 21V9 M12 9L5 3 M12 9V2.5 M12 9L19 3</Geometry>
    </Window.Resources>

    <Border BorderBrush="#1B1B22" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ SIDEBAR ============ -->
            <Border Grid.Column="0" Background="{StaticResource B.Sidebar}"
                    BorderBrush="{StaticResource B.HairlineSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <Grid Grid.Row="0" Height="96" Margin="22,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="36" Height="36" VerticalAlignment="Center">
                            <Path Data="M18 1.5 L33.6 10.2 V27.8 L18 36.5 L2.4 27.8 V10.2 Z"
                                  Stroke="{StaticResource B.Chrome}" StrokeThickness="1.1" Fill="Transparent"
                                  StrokeLineJoin="Round" />
                            <Path Data="M18 7.4 L28.6 13.7 V25.3 L18 31.6 L7.4 25.3 V13.7 Z"
                                  Stroke="#33333D" StrokeThickness="0.9" Fill="Transparent"
                                  StrokeLineJoin="Round" />
                            <Path Data="M23.2 14.6c-1.2-1.3-2.9-2-4.8-2-2.6 0-4.5 1.4-4.5 3.4 0 1.9 1.5 2.8 4.3 3.4 2.9.6 4.5 1.6 4.5 3.8 0 2.4-2.1 4-5.2 4-2.2 0-4.1-.7-5.3-2.1"
                                  Stroke="{StaticResource B.Chrome}" StrokeThickness="1.5" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,2,0,0">
                            <TextBlock Foreground="{StaticResource B.Chrome}">
                                <Run Text="Stellary" FontFamily="{StaticResource F.Display}" FontSize="33" />
                                <Run Text=".PX" FontFamily="{StaticResource F.SemiBold}" FontSize="10.5"
                                     Foreground="{StaticResource B.Muted}" BaselineAlignment="Baseline" />
                            </TextBlock>
                            <TextBlock Text="P E R F O R M A N C E   C O N S O L E"
                                       FontFamily="{StaticResource F.Headline}" FontSize="6.8"
                                       Foreground="{StaticResource B.Dim}" Margin="1,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,4,0,8">
                        <ListBox ItemsSource="{Binding NavView}"
                                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                                 Style="{StaticResource NavList}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Eyebrow}"
                                                       Margin="22,17,0,5" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="15" Height="15">
                                            <Path x:Name="ico" Data="{Binding Icon}" Stroke="#7C7C86" StrokeThickness="1.35"
                                                  Fill="Transparent" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Viewbox>
                                        <TextBlock x:Name="txt" Text="{Binding Label}" Margin="11,0,0,0"
                                                   FontFamily="{StaticResource F.Body}" FontSize="12"
                                                   Foreground="#B4B4BE" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="#F0F0F4" />
                                            <Setter TargetName="ico" Property="Stroke" Value="#E8E8EE" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Developer profile -->
                    <Border Grid.Row="2" Margin="14,8,14,0" Padding="12,12,12,10"
                            Background="#0E0E12" BorderBrush="#202028" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="34" Height="34">
                                    <Ellipse Fill="#17171D" Stroke="#34343E" StrokeThickness="1" />
                                    <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource F.Headline}"
                                               FontSize="11" Foreground="{StaticResource B.Muted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Stroke="#4A4A56" StrokeThickness="0.8" Visibility="{Binding HasAvatar, Converter={StaticResource BoolVis}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Branding.DeveloperName}"
                                               FontFamily="{StaticResource F.Medium}" FontSize="12"
                                               Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="{Binding Branding.DeveloperHandle}"
                                               FontFamily="{StaticResource F.Body}" FontSize="10"
                                               Foreground="{StaticResource B.Dim}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource Hairline}" Margin="0,11,0,9" />

                            <TextBlock Text="E S K A P R O J E C T - X" FontFamily="{StaticResource F.Headline}"
                                       FontSize="8" Foreground="{StaticResource B.Dim}" />

                            <UniformGrid Columns="5" Margin="0,9,0,0">
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{Binding LinktreeUrl}" ToolTip="Linktree">
                                    <Viewbox Width="15" Height="15">
                                        <Path Data="{StaticResource Ico.Linktree}" Stroke="#8F8F99" StrokeThickness="1.5"
                                              Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{Binding WhatsAppUrl}" ToolTip="WhatsApp Channel">
                                    <Viewbox Width="15" Height="15">
                                        <Path Data="{StaticResource Ico.WhatsApp}" Stroke="#8F8F99" StrokeThickness="1.4"
                                              Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{Binding TikTokUrl}" ToolTip="TikTok">
                                    <Viewbox Width="15" Height="15">
                                        <Path Data="{StaticResource Ico.TikTok}" Stroke="#8F8F99" StrokeThickness="1.4"
                                              Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{Binding DiscordUrl}" ToolTip="Discord">
                                    <Viewbox Width="15" Height="15">
                                        <Path Data="{StaticResource Ico.Discord}" Stroke="#8F8F99" StrokeThickness="1.3"
                                              Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                        Command="{Binding OpenLinkCommand}"
                                        CommandParameter="{Binding InstagramUrl}" ToolTip="Instagram">
                                    <Viewbox Width="15" Height="15">
                                        <Path Data="{StaticResource Ico.Instagram}" Stroke="#8F8F99" StrokeThickness="1.4"
                                              Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Viewbox>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Version -->
                    <TextBlock Grid.Row="3" Text="{Binding Version}" FontFamily="{StaticResource F.Body}"
                               FontSize="9.5" Foreground="#4C4C56" Margin="22,10,0,14" />
                </Grid>
            </Border>

            <!-- ============ MAIN ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="{Binding CurrentPageEyebrow}" Style="{StaticResource T.Eyebrow}"
                                   VerticalAlignment="Center" />
                        <Rectangle Width="18" Height="1" Fill="#33333C" Margin="10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentPageTitle}" FontFamily="{StaticResource F.Body}"
                                   FontSize="11.5" Foreground="{StaticResource B.Muted}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Border Background="#0F0F13" BorderBrush="#24242C" BorderThickness="1" CornerRadius="2"
                                Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="4.5" Height="4.5" Fill="#98A9A0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ElevationText}" FontFamily="{StaticResource F.Body}"
                                           FontSize="9" Foreground="{StaticResource B.Muted}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize">
                            <Path Data="M4 12h16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Maximize">
                            <Path Data="M5 5h14v14H5z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Close">
                            <Path Data="M6 6l12 12 M18 6L6 18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False"
                                Margin="24,2,24,22" />
            </Grid>
        </Grid>
    </Border>
</Window>
